[
  {
    "claim": "Error pages do not publish website schema or load trackers",
    "paths": [
      "frontend/templates/404.html"
    ],
    "must_not_match": [
      "base_landing",
      "posthog",
      "plausible",
      "application/ld\\+json"
    ],
    "must_match": [
      "noindex, follow"
    ]
  },
  {
    "claim": "Repository archive status is not a maintenance certification",
    "paths": [
      "frontend/templates/repos/detail.html"
    ],
    "must_not_match": [
      "Actively maintained"
    ],
    "must_match": [
      "Archive status not checked",
      "Not archived",
      "not a maintenance assessment",
      "how-to-shortlist-github-repositories"
    ]
  }
]
